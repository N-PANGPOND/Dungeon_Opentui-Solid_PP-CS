      <text fg={theme.colors.coin}>{pad(`  ${theme.icons.coin}  Coins: ${p().coin}`, 78)}</text>
      <text>{" "}</text>

      {/* Prompt */}
      <text fg={theme.colors.textDim}>{pad("  Press  ESC  to exit", 78)}</text>
    </box>
  );
};
