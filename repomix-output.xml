    ])("Numpad %s ควรใช้เป็น Combat Action ได้", (key, action) => {
        const normalized = normalizeKeyName(key);

        expect(parseKeyIntent(normalized, "COMBAT")).toEqual({
            type: "COMBAT_ACTION",
