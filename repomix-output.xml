    "  ╚██████╔╝ ╚████╔╝ ███████╗██║  ██║",
    "   ╚═════╝   ╚═══╝  ╚══════╝╚═╝  ╚═╝",
    "",
  ];

  return (
    <box
      style={{
        borderStyle: theme.border.outer,
        borderColor: theme.colors.danger,
        flexDirection: "column",
        alignItems: "center",
        justifyContent: "center",
        width: 120,
        height: 40,
      }}
    >
      {/* ASCII art title */}
      {lines.map((line) => (
